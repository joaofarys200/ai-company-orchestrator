# Runtime mode
ORCHESTRATOR_MODE=local
CREWAI_TEMPERATURE=0.2

# Local WebSocket auth
# Use the same value in the frontend env if you override this token.
JARVIS_WS_TOKEN=local-dev-token
WS_AUTH_TOKEN=
VITE_JARVIS_WS_TOKEN=local-dev-token

# Local models
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434

# Orchestrator call discipline
ORCHESTRATOR_MAX_STEPS=8
ORCHESTRATOR_SPECIALIST_MAX_STEPS=3
ORCHESTRATOR_IDLE_RETRIES=1
ORCHESTRATOR_SWARM_ENABLED=false
ORCHESTRATOR_VERBOSE_PROGRESS=false
ORCHESTRATOR_AUTO_LEARN=false
ORCHESTRATOR_COMPLEXITY_MODEL_ENABLED=false

# Explicit, bounded Mission autonomy
JARVIS_MISSION_AUTONOMY_MAX_STEPS=3
JARVIS_MISSION_AUTONOMY_STALE_LOCK_SECONDS=300

# Cloud model providers - leave empty unless you use them
GEMINI_API_KEY=
GEMINI_CREW_MODEL=gemini/gemini-2.5-flash
GEMINI_LIVE_VOICE=Puck

# Voice mode
VOICE_MODE=none
VOICE_MODEL=tiny
VOICE_DEVICE_INDEX=
VOICE_GAIN=1.0
VOICE_VAD_SENSITIVITY=2
VOICE_RMS_THRESHOLD=900
VOICE_MIN_SPEECH_MS=240
VOICE_INTERRUPTION=true
VOICE_INTERRUPT_MIN_SPEECH_MS=500
VOICE_INTERRUPT_COOLDOWN_MS=1200
VOICE_INTERRUPT_RMS_THRESHOLD=900
VOICE_CONFIRMATION_MODE=true
VOICE_CONFIRMATION_TTL_SECONDS=600
VOICE_ALLOW_TOOLS=false
VOICE_ALLOW_READONLY_TOOLS=true
VOICE_AUTO_READONLY=true
VOICE_ALLOWED_TOOLS=

# Optional external tools
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=
BROWSERBASE_API_KEY=
COMPOSIO_API_KEY=

# Local storage and preview
OBSIDIAN_VAULT_PATH=
DOCKER_PORT=8080

# Electron/dev
VITE_DEV=0
