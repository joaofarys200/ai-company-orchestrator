{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "jarvis/security-event/v1",
  "title": "SecurityEvent",
  "description": "Telemetry event observed by Security Sentinel host collectors.",
  "type": "object",
  "required": ["event_id", "category", "severity", "timestamp", "fingerprint"],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique security event identifier."
    },
    "fingerprint": {
      "type": "string",
      "description": "Deterministic hash of normalized event attributes for deduplication."
    },
    "category": {
      "type": "string",
      "enum": [
        "PROCESS", "NETWORK", "PERSISTENCE", "BROWSER", "HOSTS",
        "AUTHENTICATION", "PRIVILEGE", "FILE_SYSTEM", "SERVICE",
        "TASK_SCHEDULER", "REGISTRY", "DEFENDER", "SYSTEM"
      ],
      "description": "Subsystem classification of the event."
    },
    "severity": {
      "type": "string",
      "enum": ["BENIGN", "SUSPICIOUS", "HIGH_RISK", "CONFIRMED_MALICIOUS", "UNKNOWN"],
      "description": "Calculated threat level."
    },
    "timestamp": {
      "type": "number",
      "description": "Unix timestamp in seconds when the event occurred."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 1.0,
      "description": "Classification confidence score."
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of raw collector telemetry attached to this event."
    },
    "rationale": {
      "type": "string",
      "description": "Explanation of why this event was flagged."
    },
    "recommended_action": {
      "type": "string",
      "description": "Suggested response action."
    },
    "is_known_good": {
      "type": "boolean",
      "default": false,
      "description": "True if whitelisted as benign by human approval or baseline."
    },
    "schema_version": {
      "type": "integer",
      "default": 1,
      "description": "Sentinel schema format version."
    }
  },
  "additionalProperties": true
}
