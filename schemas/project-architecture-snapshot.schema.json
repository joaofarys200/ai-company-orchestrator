{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "jarvis/project-architecture-snapshot/v1",
  "title": "ProjectArchitectureSnapshot",
  "description": "Canonical schema for deterministic project intake and architecture snapshots in JARVIS OS.",
  "type": "object",
  "required": [
    "project",
    "stack",
    "entrypoints",
    "packages",
    "services",
    "files",
    "symbols",
    "imports",
    "dependencies",
    "api_contracts",
    "tests",
    "build",
    "runtime",
    "architecture",
    "generated_at",
    "snapshot_hash",
    "confidence"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": ["project_id", "project_name", "root_path"],
      "properties": {
        "project_id": { "type": "string" },
        "project_name": { "type": "string" },
        "root_path": { "type": "string" }
      },
      "additionalProperties": true
    },
    "stack": {
      "type": "object",
      "required": ["languages", "frameworks", "package_managers", "build_tools", "test_frameworks", "containerization"],
      "properties": {
        "languages": { "type": "array", "items": { "type": "string" } },
        "frameworks": { "type": "array", "items": { "type": "string" } },
        "package_managers": { "type": "array", "items": { "type": "string" } },
        "build_tools": { "type": "array", "items": { "type": "string" } },
        "test_frameworks": { "type": "array", "items": { "type": "string" } },
        "containerization": { "type": "array", "items": { "type": "string" } },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["source", "confidence", "resolution_method"],
            "properties": {
              "source": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "resolution_method": { "type": "string" },
              "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN"] }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "source", "confidence", "resolution_method"],
        "properties": {
          "path": { "type": "string" },
          "kind": { "type": "string", "enum": ["CLI", "BACKEND", "FRONTEND", "WORKER", "SCRIPT", "BOOTSTRAP", "UNKNOWN"] },
          "source": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "resolution_method": { "type": "string" },
          "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN"] }
        },
        "additionalProperties": true
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "kind"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "kind": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "category", "root_path"],
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string", "enum": ["FRONTEND", "BACKEND", "DATABASE", "SHARED", "TESTS", "BUILD", "RUNTIME", "OTHER"] },
          "root_path": { "type": "string" },
          "entrypoints": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string" },
          "language": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "symbols": {
      "type": "object",
      "required": ["total_count", "classes_count", "functions_count", "interfaces_count"],
      "properties": {
        "total_count": { "type": "integer", "minimum": 0 },
        "classes_count": { "type": "integer", "minimum": 0 },
        "functions_count": { "type": "integer", "minimum": 0 },
        "interfaces_count": { "type": "integer", "minimum": 0 },
        "key_symbols": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "imports": {
      "type": "object",
      "required": ["total_imports", "internal_imports", "external_imports"],
      "properties": {
        "total_imports": { "type": "integer", "minimum": 0 },
        "internal_imports": { "type": "integer", "minimum": 0 },
        "external_imports": { "type": "integer", "minimum": 0 },
        "edges": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "source": { "type": "string" },
          "is_dev": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "api_contracts": {
      "type": "object",
      "required": ["endpoints", "client_calls"],
      "properties": {
        "endpoints": { "type": "array", "items": { "type": "object" } },
        "client_calls": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "tests": {
      "type": "object",
      "required": ["test_files", "frameworks", "suggested_commands"],
      "properties": {
        "test_files": { "type": "array", "items": { "type": "string" } },
        "frameworks": { "type": "array", "items": { "type": "string" } },
        "suggested_commands": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "build": {
      "type": "object",
      "required": ["build_systems", "package_scripts", "suggested_commands"],
      "properties": {
        "build_systems": { "type": "array", "items": { "type": "string" } },
        "package_scripts": { "type": "object" },
        "suggested_commands": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": ["runtime_source"],
      "properties": {
        "runtime_source": { "type": "string" },
        "python_executable": { "type": ["string", "null"] },
        "node_executable": { "type": ["string", "null"] },
        "runtime_version": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "architecture": {
      "type": "object",
      "required": ["summary_tree", "data_flows"],
      "properties": {
        "summary_tree": { "type": "string" },
        "data_flows": { "type": "array", "items": { "type": "string" } },
        "components_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_commit": {
      "type": ["string", "null"]
    },
    "snapshot_hash": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "staleness": {
      "type": "string",
      "enum": ["FRESH", "STALE", "PARTIALLY_STALE"]
    }
  },
  "additionalProperties": true
}
